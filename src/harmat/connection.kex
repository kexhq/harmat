# Harmat.Connection — the database, as a capability.
#
# Every statement `Harmat.Database` builds is sent through here. Outside any
# `with` there is no database; an application installs the one it has for
# the region that serves requests, and a spec installs one that records
# statements instead of running them:
#
#   with Harmat.Connection = Harmat.Database.Direct { connection: connection } do
#     site.start(host, port)
#   end
#
# A replacement reaches the processes spawned inside the region, and the
# blocks and function references written inside it — so routes that name
# their actions have to be built inside it too, not only served there.
capability Harmat.Connection do
  # Runs a statement that changes rows; how many it changed.
  foul run(statement: Harmat.Odbc.Statement) -> Result<Integer, String> = Error("no database connected")

  # Runs a SELECT; its rows, each as its cells in column order.
  foul ask(statement: Harmat.Odbc.Statement) -> Result<[[String]], String> = Error("no database connected")
end

# Harmat.Database — queries the way Drizzle writes them.
#
#   using Harmat.Database, as: Database
#
#   Database.select().from(users).where(Users.email == email).all
#   Database.select([:id, :email]).from(users).orderBy([:email]).limit(10).all
#   Database.select().from(messages).orderBy(descending: [:sent_at]).limit(200).all
#   Database.insert(users).values({id: id, email: email}).run
#   Database.update(users).set({email: email}).where(Users.id == id).run
#   Database.delete(users).where(Users.id == id).run
#
# `users` is a table declared with `Harmat.Table`; `Users.id` is one of its
# typed column handles, so `Users.id == 42` on a text column does not
# build. A row comes back as a map from column name to text.
#
# Nothing is sent until a builder is finished: `all`, `first` or `run`. It
# is then sent through `Harmat.Connection`, the capability an application
# installs its database as — so a query names no database, and none is
# handed around:
#
#   with Harmat.Connection = Harmat.Database.Direct { connection: connection } do
#     Database.select().from(users).all
#   end
#
# The everyday ones have a shorter spelling — each still exactly one query,
# finished and sent where it is written, answering rows and never anything
# that queries again later:
#
#   Database.all(users)                       # every row
#   Database.find(users, id)                  # the row of this primary key, or None
#   Database.findBy(users, {email: email})    # the first row with these values
#   Database.find(users, id, as: User)        # either, as a record
#   Database.select().from(users).by({owner: "ada"}).pluck(:email)   # one column
#   Database.insertAll(users, [first, second])            # several rows
#   Database.exists?(users, {email: email})               # whether any row has these
#   Database.belongingTo(posts, users, ids)   # the posts of each of these users
#
# Any query can answer with records instead of rows, of the type it is
# given — `.all(as: User)`, `.first(as: User)` — and be narrowed by a map
# of column to value as well as by conditions:
#
#   Database.select().from(users).by({owner: "ada", credit: 5}).all(as: User)
#
# A field is filled from the column of its name in snake case —
# `ownerId` from `owner_id`, `admin?` from `admin` — read as its type: text,
# a number, a flag ("TRUE", "true", "t", "1" or "yes"), an option ("" is
# `None`), a list of text (separated by commas), or a constructor of a sum
# type (`GroupChat` from "group_chat"). A field whose type is an alias is
# read as text: Kex does not tell what an alias stands for at run time
# (kexhq/kex#530). A field with no column of its name, or whose column holds
# what its type cannot read, takes its declared default, and a record with
# a required field left unfilled is an error. `renamed` maps a field to a
# column of another name. A constructor written with `values`, `set` or
# `by` is stored by that same name.
#
# `belongingTo` is a has-many loaded for many rows at once: the rows of one
# table that refer to any of some keys of another, grouped by the key they
# refer to. Which column refers is what the table declares (`belongsTo`,
# or `references:`).
#
# `Database.within(condition)` starts statements that all carry that condition —
# reads, updates and deletes alike. What is confined to one owner cannot
# touch another's rows, whatever the query built on it says.
module Harmat.Database

using Harmat.Schema, only: [Cond, Value, Text, Whole]
using Harmat.Odbc, only: [Statement]
using Harmat.Table, only: [Definition]
using Harmat.Column, only: [Column, Storage, Characters, Flag, named, snaked]

# An open connection as `Harmat.Connection`, for code that runs in the
# process that owns it. (An ODBC connection answers only the process that
# opened it: an application serving many processes installs something that
# asks the owner instead.)
record Direct do
  connection : Any
end

make Direct, implement: Harmat.Connection do
  foul run(statement: Harmat.Odbc.Statement) -> Result<Integer, String> do
    return Harmat.Odbc.executing(@connection, statement) if Harmat.Database.ongoing().set?
    return Harmat.Odbc.execute(@connection, statement)
  end

  foul ask(statement: Harmat.Odbc.Statement) -> Result<[[String]], String> do
    return Harmat.Odbc.querying(@connection, statement) if Harmat.Database.ongoing().set?
    return Harmat.Odbc.query(@connection, statement)
  end

  # Runs `work` with this connection left open between its statements,
  # then keeps all of it or none. A transaction begun inside one joins it.
  foul transaction(work: Block<Result<Any, String>>) -> Result<Any, String> do
    return work() if Harmat.Database.ongoing().set?

    Harmat.Database.begun(@connection)
    let outcome = work()
    Harmat.Database.ended()
    match Harmat.Odbc.finish(@connection, outcome.ok?) do
      Error(reason) => return outcome.ok? then Error(reason) else outcome
      Ok(_) => return outcome
    end
  end
end

# The connection this process is in a transaction on, if it is in one.
#
# A transaction is the process's, not a capability's: a block uses the
# `Harmat.Connection` in force where it was written, so the statements of
# `work` cannot be pointed at another connection by installing one around
# it. Whatever runs them asks this instead, and leaves the transaction open.
ongoing : Any?
foul ongoing do
  let held : Any = BEAM.erlang.get(:harmat_transaction)
  return held == :undefined then None else Just(held)
end

# Marks this process as in a transaction on `connection`, and as out of it.
begun : Any -> Void
foul begun(connection) do
  BEAM.erlang.put(:harmat_transaction, connection)
end

ended : Void
foul ended do
  BEAM.erlang.erase(:harmat_transaction)
end

record Select do
  confines : [Cond] = []
  columns : [String] = []
  source : Definition? = None
  conditions : [Cond] = []
  order : [String] = []
  cap : Integer? = None
end

record Insert do
  target : Definition
  row : {Atom: Any} = {}
end

record Update do
  confines : [Cond] = []
  target : Definition
  changes : {Atom: Any} = {}
  conditions : [Cond] = []
end

record Delete do
  confines : [Cond] = []
  target : Definition
  conditions : [Cond] = []
end

# --- Transactions -----------------------------------------------------------

# Runs `work` as one transaction: what it does is kept when it answers `Ok`,
# and undone when it answers `Error` — so `.try` inside it undoes everything
# before the failure. Its answer is `work`'s. Begun inside another, it joins
# that one.
#
#   Database.transaction do
#     Database.insert(organizations).values(row).run.try
#     Database.insert(memberships).values(member).run.try
#     Ok(organization)
#   end
foul transaction(work: Block<Result<Any, String>>) -> Result<Any, String> do
  let started = DateTime.epochNanos()
  Harmat.Logger.queried(Harmat.Odbc.plain("BEGIN"), 0, "")
  let outcome = Harmat.Connection.transaction(work)
  # What was read inside it may be what a rollback took back.
  forget()
  let ending = outcome.ok? then "COMMIT" else "ROLLBACK"
  Harmat.Logger.queried(Harmat.Odbc.plain(ending), (DateTime.epochNanos() - started) / 1000, "")
  return outcome
end

# --- The cache --------------------------------------------------------------

# Runs `work` with each query in it sent once: asked again, with the same
# SQL and the same values, it is answered with the rows it had the first
# time. Any insert, update, delete or transaction empties the cache, so
# nothing read after a change is from before it. The cache is the process's
# and lasts as long as `work`: a request, or one event of a live page —
# never a page's whole life. Begun inside another, it is that one.
#
#   Database.cache do
#     page(request)
#   end
foul cache(work: Block<T>) -> T do
  return work() if caching?()

  BEAM.erlang.put(:harmat_cache, {})
  let answer = trying do
    work()
  rescue
    reason => do
      BEAM.erlang.erase(:harmat_cache)
      BEAM.erlang.error(reason)
    end
  end
  BEAM.erlang.erase(:harmat_cache)
  return answer
end

# Whether this process is inside `cache`.
caching? : Bool
foul caching? = BEAM.erlang.get(:harmat_cache) != :undefined

# --- The tally --------------------------------------------------------------

# What a process has asked of the database: how many statements it sent,
# how many queries the cache answered instead, and how long the database
# took, in microseconds. One taken before some work and one after say what
# the work cost:
#
#   let before = Database.tally()
#   page(request)
#   Database.tally().since(before)   # => Tally { sent: 12, cached: 3, micros: 5100 }
record Tally do
  sent : Integer = 0
  cached : Integer = 0
  micros : Integer = 0
end

make Tally do
  # What was asked between `earlier` and this one.
  let since(earlier: Tally) -> Tally = Tally {
    sent: @sent - earlier.sent,
    cached: @cached - earlier.cached,
    micros: @micros - earlier.micros
  }
end

# Everything this process has asked so far.
tally : Tally
foul tally do
  let held : Any = BEAM.erlang.get(:harmat_tally)
  return Tally {} if held == :undefined
  let found : Tally = held
  return found
end

# --- The everyday queries ---------------------------------------------------

# Every row of a table.
foul all(table: Definition) -> Result<[{String: String}], String> = select().from(table).all

# The same, as records of type `as`.
foul all(table: Definition, as: T) -> Result<[T], String> = select().from(table).all(as: as)

# Inserts rows one after another, stopping at the first that fails: how
# many went in, or why one did not. Inside a transaction, a failure undoes
# them all.
foul insertAll(table: Definition, rows: [{Atom: Any}]) -> Result<Integer, String> do
  match rows do
    [] => return Ok(0)
    [row | rest] => do
      insert(table).values(row).run.try
      return insertAll(table, rest).map { |count| count + 1 }
    end
  end
end

# Whether a table has a row with these values in these columns.
foul exists?(table: Definition, values: {Atom: Any}) -> Result<Bool, String> do
  return select().from(table).by(values).count.map { |found| found > 0 }
end

# The first row of a table with these values in these columns, or `None`.
foul findBy(table: Definition, values: {Atom: Any}) -> Result<{String: String}?, String> = select().from(table).by(values).first

# The same, as a record of type `as`.
foul findBy(table: Definition, values: {Atom: Any}, as: T) -> Result<T?, String> = select().from(table).by(values).first(as: as)

# The row of a table whose primary key is `id`, or `None`.
foul find(table: Definition, id: String) -> Result<{String: String}?, String> do
  return Error("${table.label} has no primary key") if table.primaryKey.empty?

  return select().from(table)
    .where(Harmat.Schema.text(table.primaryKey) == id)
    .first
end

# The same, as a record of type `as`.
foul find(table: Definition, id: String, as: T) -> Result<T?, String> do
  return find(table, id).flatMap { |row| optionally(row, as, {}) }
end

# The rows of `owner` that refer to any of `keys` of `target`, by the key each
# refers to, each key's rows in `orderBy` order: a key nothing refers to is
# not there. Which column of `owner` refers to `target` is what `owner`
# declares; when several do, `via` names the one meant, by its column or
# by what `t.belongsTo` called it.
foul belongingTo(
  owner: Definition,
  target: Definition,
  keys: [String],
  via: Atom = :none,
  orderBy: [Atom] = []
) -> Result<{String: [{String: String}]}, String> do
  let referring = owner.columns.filter { |column|
    let chosen = via == :none || column.label == named(via) || column.relation == named(via)
    column.refers == target.label && chosen
  }
  match referring do
    [] => return Error("${owner.label} declares no column referring to ${target.label}")
    [column] => do
      return Ok({}) if keys.empty?

      let chosen = select().from(owner)
        .where(Harmat.Schema.text(column.label).in(keys.uniq))
      let rows = (orderBy.empty? then chosen else chosen.orderBy(orderBy)).all.try
      return Ok(rows.reduce({}) { |found, row|
        let key = row.get(column.label).or("")
        found.put(key, found.get(key).or([]) + [row])
      })
    end
    several => do
      let names = several.map { |column| column.label }.join(" and ")
      return Error("${names} of ${owner.label} both refer to ${target.label}: say which with `via:`")
    end
  end
end

# --- Records from rows ------------------------------------------------------

# A record of type `kind` with its fields filled from a row (see the top of
# this module). Not a decoder written for each record: the type's own
# fields say what to read, as Kex knows them at run time.
decoded : {String: String} -> T -> {String: String} -> Result<T, String>
let decoded(row, kind, renamed) do
  let model = Type.of(kind)
  let values = model.fields.reduce({}) { |found, field|
    let column = renamed.get(field.name).or(snaked(field.name))
    let value = row.get(column).flatMap { |text| read(text, field.valueType) }
    match value do
      Just(held) => found.put(field.name, held)
      None => found
    end
  }
  let built : Result<T, String> = model.construct(values)
  built
end

# Each row as a record of type `kind`, or the first reason one could not be.
decodedAll : [{String: String}] -> T -> {String: String} -> Result<[T], String>
let decodedAll(rows, kind, renamed) = rows.reduce(Ok([])) { |done, row|
  done.flatMap { |records| decoded(row, kind, renamed).map { |built| records + [built] } }
}

# A row that may not be there as a record that may not be.
optionally : {String: String}? -> T -> {String: String} -> Result<T?, String>
let optionally(row, kind, renamed) do
  match row do
    None => Ok(None)
    Just(found) => decoded(found, kind, renamed).map { |built| Just(built) }
  end
end

# A column's text as a field's type, or `None` when it cannot be read as
# one.
read : String -> Type -> Any?
let read(text, kind) do
  let value : Any? = match kind.name do
    "String" => Just(text)
    "Integer" => text.trim.split(".").first.or("").to(Integer)
    "Float" => text.trim.to(Float)
    "Bool" => Just(TRUTHS.contains?(text.trim))
    "Option" => text.empty? then Just(None) else read(text, kind.args.first.or(Type.named("String"))).map { |inner| Just(inner) }
    "List" => Just(text.split(",").map { |part| part.trim }.reject { |part| part.empty? })
    _ => kind.adt? then constructed(text, kind) else Just(text)
  end
  value
end

# What a flag column holds when it is set, in any database's spelling.
let TRUTHS = ["TRUE", "true", "t", "1", "yes"]

# The constructor of a sum type stored as `text`: `GroupChat` from
# "group_chat".
constructed : String -> Type -> Any?
let constructed(text, kind) = kind.constructorNames
  .find { |constructor| snaked(constructor) == text.trim }
  .flatMap { |constructor| kind.variant(constructor).optional }

# The conditions that a table's columns hold these values, each written as
# its column stores it. A name the table does not declare matches no row.
matches : Definition -> {Atom: Any} -> [Cond]
let matches(table, values) = values.entries.map { |entry|
  match entry do
    (key, value) => match table.columns.find { |column| column.label == named(key) } do
      None => Harmat.Schema.InCond(named(key), [])
      Just(column) => matching(column, value)
    end
  end
}

# A record's fields by column name — `ownerId` as `owner_id` — each as a
# row holds it: an option as its value or "", a list of text joined by
# commas, a constructor by its name (see `spelled`).
encoded : Any -> {Atom: Any}
let encoded(value) do
  let parts : [Any] = BEAM.erlang.tuple_to_list(value)
  Type.of(value).fields.zip(parts.drop(1)).reduce({}) { |row, pair|
    match pair do
      (field, held) => row.put(BEAM.erlang.binary_to_atom(snaked(field.name)), cell(field.valueType, held))
    end
  }
end

# A constructor as it is stored, and anything else as text: `GroupChat` is
# "group_chat".
spelled : Any -> String
let spelled(value) do
  let constructor = BEAM.erlang.is_atom(value) && value != true && value != false
  constructor then snaked("${value}") else "${value}"
end

# --- Starting a query -------------------------------------------------------

# Every column of the table named in `from`, or only the ones listed.
let select(columns: [Atom] = []) -> Select = Select { columns: columns.map { |column| named(column) } }

let insert(target: Definition) -> Insert = Insert { target: target }

let update(target: Definition) -> Update = Update { target: target }

let delete(target: Definition) -> Delete = Delete { target: target }

# Statements that all also carry `condition`.
let within(condition: Cond) -> Harmat.Confined.Confined = Harmat.Confined.Confined { confines: [condition] }

make Select do
  let from(source: Definition) -> Select = Select { ...this, source: Just(source) }

  # Narrows the rows; several `where`s all have to hold.
  let where(condition: Cond) -> Select = Select { ...this, conditions: @conditions + [condition] }

  # Narrows the rows to those with these values in these columns, each value
  # written the way its declared column stores it. A name the table does not
  # declare matches no row.
  let by(values: {Atom: Any}) -> Select do
    match @source do
      None => this
      Just(source) => Select { ...this, conditions: @conditions + Harmat.Database.matches(source, values) }
    end
  end

  # Sorts the rows: `orderBy([:email])`, or largest first with
  # `orderBy(descending: [:sent_at])` — with `limit`, the newest rows of a
  # table. Given both, the ascending columns come first.
  let orderBy(columns: [Atom] = [], descending: [Atom] = []) -> Select do
    let rising = columns.map { |column| named(column) }
    let falling = descending.map { |column| "${named(column)} DESC" }
    Select { ...this, order: rising + falling }
  end

  let limit(count: Integer) -> Select = Select { ...this, cap: Just(count) }

  # The statement this query is.
  let statement -> Result<Statement, String> do
    match @source do
      None => Error("select() was not given a table: add .from(table)")
      Just(source) => do
        let columns = @columns.empty? then source.names else @columns
        let chosen = Harmat.Odbc.selecting(source.table, columns, @confines + @conditions, @order)
        match @cap do
          Just(count) => Ok(Statement { statement: "${chosen.statement} LIMIT ${count}", params: chosen.params })
          None => Ok(chosen)
        end
      end
    end
  end

  # Runs the query: every row, as a map from column name to text.
  foul all -> Result<[{String: String}], String> do
    match this.statement do
      Error(reason) => return Error(reason)
      Ok(built) => do
        let names = @columns.empty? then @source.map { |source| source.names }.or([]) else @columns
        return asked(built).map { |rows| rows.map { |cells| keyed(names, cells) } }
      end
    end
  end

  # Runs the query for one row: the first, or `None`.
  foul first -> Result<{String: String}?, String> do
    return this.limit(1).all.map { |rows| rows.first }
  end

  # Runs the query for one column: its value in every row.
  foul pluck(column: Atom) -> Result<[String], String> do
    let name = named(column)
    return Select { ...this, columns: [name] }.all.map { |rows| rows.map { |row| row.get(name).or("") } }
  end

  # Runs the query: every row, as a record of type `as` (see the top of
  # this module for how a field is filled). `renamed` maps a field to a
  # column of another name.
  #
  # (Two of each, not a `renamed` that defaults to `{}`: a method named like
  # another, called from another module without its defaulted argument, is
  # a call to a function that is not there — kexhq/kex#531.)
  foul all(as: T) -> Result<[T], String> = this.all(as: as, renamed: {})

  foul all(as: T, renamed: {String: String}) -> Result<[T], String> do
    return this.all.flatMap { |rows| Harmat.Database.decodedAll(rows, as, renamed) }
  end

  # Runs the query for one row, as a record of type `as`: the first, or
  # `None`.
  foul first(as: T) -> Result<T?, String> = this.first(as: as, renamed: {})

  foul first(as: T, renamed: {String: String}) -> Result<T?, String> do
    return this.first.flatMap { |row| Harmat.Database.optionally(row, as, renamed) }
  end

  # Runs the query for how many rows match. The columns, order and limit
  # asked for do not count.
  foul count -> Result<Integer, String> do
    match @source do
      None => return Error("select() was not given a table: add .from(table)")
      Just(source) => do
        let built = Harmat.Odbc.counting(source.table, [], @confines + @conditions)
        return asked(built).map { |rows| whole(rows.first.or([]).first.or("0")) }
      end
    end
  end

  # Runs the query for how many rows match for each value of one column:
  # `countBy(:owner)` is `{"ada": 2, "bob": 1}`. A value no row has is not
  # there, rather than 0.
  foul countBy(column: Atom) -> Result<{String: Integer}, String> do
    match @source do
      None => return Error("select() was not given a table: add .from(table)")
      Just(source) => do
        let built = Harmat.Odbc.counting(source.table, [named(column)], @confines + @conditions)
        let counted : Result<[[String]], String> = asked(built)
        return counted.map { |rows|
          rows.reduce({}) { |tallies, cells|
            let value = cells.first.or("")
            let tally = whole(cells.drop(1).first.or("0"))
            tallies.put(value, tally)
          }
        }
      end
    end
  end
end

make Insert do
  # The row to insert, by column name: `{id: id, email: email}`.
  let values(row: {Atom: Any}) -> Insert = Insert { ...this, row: row }

  # The row to insert, from a record: each of its fields into the column
  # of its name in snake case, where the table has one, and `extra` for the
  # columns the record does not carry.
  let record(value: Any, extra: {Atom: Any} = {}) -> Insert do
    let fields = Harmat.Database.encoded(value)
      .entries
      .filter { |entry|
        match entry do
          (key, _) => @target.names.contains?(named(key))
        end
      }
      .reduce({}) { |row, entry|
        match entry do
          (key, field) => row.put(key, field)
        end
      }
    Insert { ...this, row: extra.entries.reduce(fields) { |row, entry|
      match entry do
        (key, field) => row.put(key, field)
      end
    } }
  end

  let statement -> Result<Statement, String> do
    assigned(@target, @row).map { |fields| Harmat.Odbc.inserting(@target.table, fields) }
  end

  # Runs the insert; the number of rows inserted.
  foul run -> Result<Integer, String> do
    match this.statement do
      Error(reason) => return Error(reason)
      Ok(built) => return ran(built)
    end
  end
end

make Update do
  # The columns to change, by name: `{email: email}`.
  let set(changes: {Atom: Any}) -> Update = Update { ...this, changes: changes }

  let where(condition: Cond) -> Update = Update { ...this, conditions: @conditions + [condition] }

  # Only the rows with these values in these columns, as `Select.by`.
  let by(values: {Atom: Any}) -> Update = Update { ...this, conditions: @conditions + Harmat.Database.matches(@target, values) }

  let statement -> Result<Statement, String> do
    assigned(@target, @changes).map { |fields| Harmat.Odbc.updating(@target.table, fields, @confines + @conditions) }
  end

  # Runs the update; the number of rows it changed.
  foul run -> Result<Integer, String> do
    match this.statement do
      Error(reason) => return Error(reason)
      Ok(built) => return ran(built)
    end
  end
end

make Delete do
  let where(condition: Cond) -> Delete = Delete { ...this, conditions: @conditions + [condition] }

  # Only the rows with these values in these columns, as `Select.by`.
  let by(values: {Atom: Any}) -> Delete = Delete { ...this, conditions: @conditions + Harmat.Database.matches(@target, values) }

  let statement -> Statement = Harmat.Odbc.deleting(@target.table, @confines + @conditions)

  # Runs the delete; the number of rows it removed.
  foul run -> Result<Integer, String> do
    return ran(this.statement)
  end
end

private do
  # A SELECT, run and timed, and told to the logger (`Harmat.Logger`) —
  # or answered from the cache, and told as that.
  foul asked(statement: Statement) -> Result<[[String]], String> do
    match lookup(statement) do
      Just(found) => do
        count(0, 1, 0)
        Harmat.Logger.queried(statement, 0, "${counted(found)} (cache)")
        return Ok(found)
      end
      None => ()
    end
    let started = DateTime.epochNanos()
    let rows = Harmat.Connection.ask(statement)
    let outcome = match rows do
      Ok(found) => counted(found)
      Error(reason) => "failed: ${reason}"
    end
    let micros = (DateTime.epochNanos() - started) / 1000
    count(1, 0, micros)
    Harmat.Logger.queried(statement, micros, outcome)
    match rows do
      Ok(found) => store(statement, found)
      Error(_) => ()
    end
    return rows
  end

  # Adds to this process's tally.
  count : Integer -> Integer -> Integer -> Void
  foul count(sent, cached, micros) do
    let now = Harmat.Database.tally()
    BEAM.erlang.put(:harmat_tally, Harmat.Database.Tally {
      sent: now.sent + sent,
      cached: now.cached + cached,
      micros: now.micros + micros
    })
  end

  # How many rows, in words.
  counted : [[String]] -> String
  let counted(rows) = rows.count == 1 then "1 row" else "${rows.count} rows"

  # The rows a query had before, if this process is caching and it was
  # asked.
  lookup : Statement -> [[String]]?
  foul lookup(statement) do
    return None if !caching?()
    let held : {Statement: [[String]]} = BEAM.erlang.get(:harmat_cache)
    return held.get(statement)
  end

  # Keeps the rows a query had, if this process is caching.
  store : Statement -> [[String]] -> Void
  foul store(statement, rows) do
    return if !caching?()
    let held : {Statement: [[String]]} = BEAM.erlang.get(:harmat_cache)
    BEAM.erlang.put(:harmat_cache, held.put(statement, rows))
  end

  # Empties the cache, if this process is caching: something has changed.
  forget : Void
  foul forget do
    BEAM.erlang.put(:harmat_cache, {}) if caching?()
  end

  # A statement that changes rows, run and timed, and told to the logger.
  foul ran(statement: Statement) -> Result<Integer, String> do
    let started = DateTime.epochNanos()
    forget()
    let changed = Harmat.Connection.run(statement)
    let outcome = match changed do
      Ok(count) => "${count} changed"
      Error(reason) => "failed: ${reason}"
    end
    let micros = (DateTime.epochNanos() - started) / 1000
    count(1, 0, micros)
    Harmat.Logger.queried(statement, micros, outcome)
    return changed
  end

  # A count as a database gives it back: "3", or "3.0" from some drivers.
  whole : String -> Integer
  let whole(text) = text.split(".").first.or("0").to(Integer).or(0)

  keyed : [String] -> [String] -> {String: String}
  let keyed(names, cells) do
    names.zip(cells).reduce({}) { |row, pair| match pair do (name, cell) => row.put(name, cell) end }
  end

  # A map of column name to value as bound fields, each written the way its
  # declared column stores it. A name the table does not declare is an error
  # here rather than one from the database.
  assigned : Definition -> {Atom: Any} -> Result<[(String, Value)], String>
  let assigned(target, given) do
    given.entries.reduce(Ok([])) { |fields, entry|
      match (fields, entry) do
        (Error(reason), _) => Error(reason)
        (Ok(done), (key, value)) => match target.columns.find { |column| column.label == named(key) } do
          None => Error("${target.label} has no column ${named(key)}")
          Just(column) => Ok(done + [(column.label, stored(column.storage, value))])
        end
      end
    }
  end

  # The condition that a column holds a value, written the way the column
  # stores it.
  matching : Column -> Any -> Cond
  let matching(column, value) do
    match stored(column.storage, value) do
      Whole(number) => Harmat.Schema.integer(column.label) == number
      Text(text) => Harmat.Schema.text(column.label) == text
    end
  end

  # A field's value as a row holds it.
  cell : Type -> Any -> Any
  let cell(kind, held) do
    let value : Any = match (kind.name, held) do
      ("Option", None) => ""
      ("Option", Just(inner)) => inner
      ("List", items) => items.map { |item| "${item}" }.join(",")
      _ => held
    end
    value
  end

  # `Whole` is both a stored value in Harmat.Schema and a column's storage
  # in Harmat.Migration, so the values are built by their full names.
  stored : Storage -> Any -> Value
  let stored(Characters, value) = Harmat.Schema.Text(Harmat.Database.spelled(value))
  let stored(Flag, value) = Harmat.Schema.Text(value == true then "TRUE" else "FALSE")
  let stored(storage, value) = Harmat.Schema.Whole(value)
end

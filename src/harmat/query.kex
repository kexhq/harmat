# Harmat.Query — a query builder that evaporates.
#
# Everything builder-shaped lives inside `compiled do`: a chain whose
# arguments are known at compile time is evaluated during compilation
# and replaced by its Query result, so no Builder is ever allocated
# and `emit` never runs. A chain mentioning runtime values collapses
# too — the values ride through as placeholders into `params` while
# the text is still baked. `--collapse-report` shows what went.

module Harmat.Query do
  using Harmat.Schema, only: [Table, Cond, EqCond, NullCond]

  # The finished product: static text plus bound values.
  #
  # The field is `statement`, not `text`: on the BEAM backend a
  # same-named function in scope hijacks `q.text` into a call
  # (in-repo precedent: regex.kex on `message`), while the walker
  # reads the field. Distinctive names dodge the whole class.
  record Query do
    statement : String
    params    : [Any] = []
  end

  # The chain state. Never survives compilation when collapse fires.
  record Builder do
    table      : String = ""
    fields     : [String] = []
    conditions : [Cond] = []
    order      : String? = None
    limit_val  : Int? = None
  end

  compiled do
    let select(fields: [String]) -> Harmat.Query.Builder do
      Builder { fields: fields }
    end

    make Builder do
      let from(table: Harmat.Schema.Table) -> Harmat.Query.Builder do
        Builder {
          fields: @fields,
          table: table.label,
          conditions: @conditions
        }
      end

      let where(conditions: [Harmat.Schema.Cond]) -> Harmat.Query.Builder do
        Builder {
          fields: @fields,
          table: @table,
          conditions: @conditions + conditions,
          order: @order,
          limit_val: @limit_val
        }
      end

      let orderBy(col: String) -> Harmat.Query.Builder do
        Builder {
          fields: @fields,
          table: @table,
          conditions: @conditions,
          order: Just(col),
          limit_val: @limit_val
        }
      end

      let limit(n: Int) -> Harmat.Query.Builder do
        Builder {
          fields: @fields,
          table: @table,
          conditions: @conditions,
          order: @order,
          limit_val: Just(n)
        }
      end

      let emit() -> Harmat.Query.Query do
        let field_str = @fields.join(", ")
        var sql = "SELECT ${field_str} FROM ${@table}"
        var params = []
        var first = true

        @conditions.each do |c|
          let prefix = if first then " WHERE " else " AND " end
          match c do
            EqCond(col, val) => do
              sql = sql + "${prefix}${col} = ?"
              params = params + [val]
              first = false
            end
            NullCond(col) => do
              sql = sql + "${prefix}${col} IS NULL"
              first = false
            end
          end
        end

        match @order do
          Just(o) => do
            sql = sql + " ORDER BY ${o}"
          end
          None => ()
        end

        match @limit_val do
          Just(lim) => do
            sql = sql + " LIMIT ?"
            params = params + [lim]
          end
          None => ()
        end

        Query { statement: sql, params: params }
      end
    end
  end

  # The `sql` tag. Deliberately NOT in `compiled do`: the validator
  # only collects plain definitions, so a compiled tag would keep its
  # runtime behavior but silently lose compile-time checking — and
  # checking is the tag's whole point. `$`-holes become bound params,
  # never text.
  #
  #   sql`SELECT name FROM users WHERE id = ?`
  #   sql$`UPDATE users SET age = ${age} WHERE id = ${id}`
  sql : [String] -> [Any] -> Query
  let sql(parts: [String], values: [Any]) -> Harmat.Query.Query do
    let tail = values.mapIndexed do |_, i|
      "?" + parts.at(i + 1).or("")
    end
    Query { statement: parts.at(0).or("") + tail.join(""), params: values }
  end

  # Compile-time syntax check for `sql` literals. Pure by requirement:
  # the compiler evaluates it on the tree-walk interpreter while
  # building, so it cannot touch the clock, the filesystem, or a DB.
  # Semantics (do these tables exist?) belong to the snapshot audit.
  validateSql : String -> [TaggedValidation.Issue]
  let validateSql(source: String) -> [TaggedValidation.Issue] do
    return [TaggedValidation.fatal("empty SQL literal")] if source.trim.empty?

    let head = source.trim.upperCase
    let keywords = [
      "SELECT", "INSERT", "UPDATE", "DELETE", "CREATE",
      "ALTER", "DROP", "WITH", "EXPLAIN"
    ]
    let known = keywords.any? { |k| head.startsWith?(k) }
    return [TaggedValidation.fatal("SQL must begin with a statement keyword")] if !known

    let code = Harmat.Query.outsideQuotes(source)
    let opens = code.split("(").count - 1
    let closes = code.split(")").count - 1
    return [TaggedValidation.fatal("unbalanced parentheses")] if opens != closes

    let quotes = source.split("'").count - 1
    return [TaggedValidation.fatal("unterminated string literal")] if quotes.modulo(2) != 0

    return []
  end

  private do
    # The literal with quoted regions removed, so a parenthesis inside
    # 'text' cannot unbalance the check. Splitting on a quote keeps
    # even-indexed segments outside strings; doubled '' escapes are
    # parity-neutral, so they stay correct for free.
    outsideQuotes : String -> String
    let outsideQuotes(source: String) -> String do
      let kept = source.split("'").mapIndexed do |seg, i|
        if i.modulo(2) == 0 then seg else "" end
      end
      return kept.join("")
    end
  end
end

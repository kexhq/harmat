# Harmat.Query — a query builder that evaporates.
#
# Everything builder-shaped lives inside `compiled do`: a chain whose
# arguments are known at compile time is evaluated during compilation
# and replaced by its Query result, so no Builder is ever allocated
# and `emit` never runs. A chain mentioning runtime values collapses
# too — the values ride through as placeholders into `params` while
# the text is still baked. `--collapse-report` shows what went.

module Harmat.Query do
  using Harmat.Schema, only: [Table, Cond, EqCond, InCond, CmpCond, NullCond, AnyCond, AllCond, Text, Whole]

  # The finished product: static text plus bound values.
  #
  # The field is `statement`, not `text`: on the BEAM backend a
  # same-named function in scope hijacks `q.text` into a call
  # (in-repo precedent: regex.kex on `message`), while the walker
  # reads the field. Distinctive names dodge the whole class.
  record Query do
    statement : String
    params    : [Any] = []
  end

  # The chain state. Never survives compilation when collapse fires.
  record Builder do
    table      : String = ""
    fields     : [String] = []
    conditions : [Cond] = []
    order      : String? = None
    limit_val  : Int? = None
  end

  compiled do
    # One condition as SQL and the values it binds. `nested?` when it sits
    # inside another, so a group of several is bracketed.
    let condSql(c: Harmat.Schema.Cond, nested?: Bool) -> (String, [Any]) do
      match c do
        EqCond(col, val) => ("${col} = ?", [val])
        InCond(col, []) => ("1 = 0", [])
        InCond(col, vals) => ("${col} IN (${vals.map { |_| "?" }.join(", ")})", vals)
        CmpCond(col, operator, Text(text)) => ("${col} ${operator} ?", [text])
        CmpCond(col, operator, Whole(number)) => ("${col} ${operator} ?", [number])
        NullCond(col) => ("${col} IS NULL", [])
        AnyCond([]) => ("1 = 0", [])
        AllCond([]) => ("1 = 1", [])
        AnyCond(parts) => Harmat.Query.groupSql(parts, " OR ", nested?)
        AllCond(parts) => Harmat.Query.groupSql(parts, " AND ", nested?)
      end
    end

    let groupSql(parts: [Harmat.Schema.Cond], joiner: String, nested?: Bool) -> (String, [Any]) do
      let pieces = parts.map { |part| Harmat.Query.condSql(part, true) }
      let inner = pieces.map { |piece| match piece do (text, _) => text end }.join(joiner)
      let bound = pieces.flatMap { |piece| match piece do (_, vals) => vals end }
      let text = parts.count > 1 || nested? then "(${inner})" else inner
      (text, bound)
    end

    let select(fields: [String]) -> Harmat.Query.Builder do
      Builder { fields: fields }
    end

    make Builder do
      let from(table: Harmat.Schema.Table) -> Harmat.Query.Builder do
        Builder {
          fields: @fields,
          table: table.label,
          conditions: @conditions
        }
      end

      let where(conditions: [Harmat.Schema.Cond]) -> Harmat.Query.Builder do
        Builder {
          fields: @fields,
          table: @table,
          conditions: @conditions + conditions,
          order: @order,
          limit_val: @limit_val
        }
      end

      let orderBy(col: String) -> Harmat.Query.Builder do
        Builder {
          fields: @fields,
          table: @table,
          conditions: @conditions,
          order: Just(col),
          limit_val: @limit_val
        }
      end

      let limit(n: Int) -> Harmat.Query.Builder do
        Builder {
          fields: @fields,
          table: @table,
          conditions: @conditions,
          order: @order,
          limit_val: Just(n)
        }
      end

      let emit() -> Harmat.Query.Query do
        let field_str = @fields.join(", ")
        var sql = "SELECT ${field_str} FROM ${@table}"
        var params = []
        var first = true

        @conditions.each do |c|
          let prefix = first then " WHERE " else " AND "
          let (part, bound) = Harmat.Query.condSql(c, false)
          sql = sql + "${prefix}${part}"
          params = params + bound
          first = false
        end

        match @order do
          Just(o) => do
            sql = sql + " ORDER BY ${o}"
          end
          None => ()
        end

        match @limit_val do
          Just(lim) => do
            sql = sql + " LIMIT ?"
            params = params + [lim]
          end
          None => ()
        end

        Query { statement: sql, params: params }
      end
    end
  end
end

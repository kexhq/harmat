package "harmat" do
  version("0.1.0")
  description("A drizzle-like typed query builder for Kex")
  kex(">= 0.4.0-rc.1")

  # Harmat's generators, as a Tey plugin: from an application that depends on
  # Harmat, `tey generate harmat:migration --name add_avatars --force` writes
  # the next numbered migration, following the current head, and lists it.
  plugin namespace: "harmat", tey: ">= 0.2" do
    capabilities([FS.Write.workspace])

    generator("migration", entrypoint: "generators/migration.kex") do
      option("name", type: String)
    end
  end
end

using Harmat.Migration, only: [string, bigint]
using Harmat.Table, only: [Definition, define]
using Harmat.Repository, only: [Gateway, Relation]

let notes = define "notes" do
  string("id").primaryKey
  string("owner")
  string("body")
end

record NoteRepository do
  relation : Relation
end

let notesOf(database: Gateway, owner: String) -> NoteRepository = NoteRepository {
  relation: Relation {
    gateway: database,
    source: notes.table,
    selection: ["id", "body"],
    identifier: notes.text("id"),
    confines: [notes.text("owner").eqTo(owner)]
  }
}

make NoteRepository do
  foul bodies -> Result<[String], String> do
    return @relation.selected([], ["id"]).map { |rows| rows.map { |row| row.last.or("") } }
  end
end

# A gateway that runs nothing and answers with the SQL it was handed.
foul echoing() -> Gateway do
  Gateway {
    run: do |statement| Error("${statement.statement} ${statement.params}") end,
    ask: do |statement| Error("${statement.statement} ${statement.params}") end
  }
end

foul dsn(file: String) -> String do
  ENV.get("HARMAT_SPEC_DSN").or("Driver=/opt/homebrew/lib/libsqlite3odbc.dylib;Database=${file}")
end

describe("Harmat.Repository statements") do
  let relation : Relation = notesOf(echoing(), "ada").relation

  it("confines every read to its conditions") do
    Assert.equal(relation.selected([], ["id"]), Error("SELECT id, body FROM notes WHERE owner = ? ORDER BY id [ada]"))
    Assert.equal(relation.selectedOne("n1"), Error("SELECT id, body FROM notes WHERE owner = ? AND id = ? [ada, n1]"))
  end

  it("confines updates and deletes the same way") do
    Assert.equal(relation.updated("n1", [notes.text("body").storing("hi")]), Error("UPDATE notes SET body = ? WHERE owner = ? AND id = ? [hi, ada, n1]"))
    Assert.equal(relation.deleted("n1"), Error("DELETE FROM notes WHERE owner = ? AND id = ? [ada, n1]"))
    Assert.equal(relation.updatedWhere([notes.text("body").eqTo("")], [notes.text("body").storing("-")]), Error("UPDATE notes SET body = ? WHERE owner = ? AND body = ? [-, ada, ]"))
  end

  it("inserts what it is given") do
    Assert.equal(relation.inserted([notes.text("id").storing("n1"), notes.text("owner").storing("ada")]), Error("INSERT INTO notes (id, owner) VALUES (?, ?) [n1, ada]"))
  end
end

describe("Harmat.Repository against a database") do
  it("keeps one owner's rows from another") do
    let file = "harmat_repo_${BEAM.erlang.system_time(:millisecond)}.db"
    Harmat.Database.sideload(".odbc")
    let connection = Harmat.Database.connect(dsn(file)).try
    Harmat.Database.execute(connection, Harmat.Database.plain("CREATE TABLE notes (id TEXT PRIMARY KEY, owner TEXT NOT NULL, body TEXT NOT NULL)")).try
    let database = Harmat.Repository.direct(connection)
    let ada = notesOf(database, "ada")
    let bob = notesOf(database, "bob")

    ada.relation.inserted([notes.text("id").storing("n1"), notes.text("owner").storing("ada"), notes.text("body").storing("hers")]).try
    Assert.equal(ada.bodies, Ok(["hers"]))
    Assert.equal(bob.bodies, Ok([]))
    Assert.equal(bob.relation.selectedOne("n1"), Ok(None))
    Assert.equal(bob.relation.updated("n1", [notes.text("body").storing("his")]), Ok(0))
    Assert.equal(bob.relation.deleted("n1"), Ok(false))
    Assert.equal(ada.relation.updated("n1", [notes.text("body").storing("still hers")]), Ok(1))
    Assert.equal(ada.bodies, Ok(["still hers"]))
    Assert.equal(ada.relation.deleted("n1"), Ok(true))
    FS.File.delete(file)
  end
end

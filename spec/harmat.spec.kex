using Harmat.Schema, only: [table, integer, text, optInteger, optText]
using Harmat.Query, only: [select]
using Harmat.Sql, only: [sql]

describe "Harmat.Query builder" do
  it "renders a static query with no params" do
    let q = select(["name", "email"]).from(table("users")).emit()
    Assert.equal(q.statement, "SELECT name, email FROM users")
    Assert.equal(q.params, [])
  end

  it "binds runtime values as params" do
    let userId = 42
    let q = select(["name"]).from(table("users")).where([Harmat.Schema.integer("id").eqTo(userId)]).emit()
    Assert.equal(q.statement, "SELECT name FROM users WHERE id = ?")
    Assert.equal(q.params, [42])
  end

  it "renders IS NULL for nullable columns" do
    let q = select(["name"]).from(table("users")).where([optInteger("age").isNull]).emit()
    Assert.equal(q.statement, "SELECT name FROM users WHERE age IS NULL")
    Assert.equal(q.params, [])
  end

  it "renders IN with one param per value, and an empty list as false" do
    let q = select(["name"]).from(table("users")).where([text("email").in(["a@b.co", "c@d.co"])]).emit()
    Assert.equal(q.statement, "SELECT name FROM users WHERE email IN (?, ?)")
    Assert.equal(q.params, ["a@b.co", "c@d.co"])
    let none = select(["name"]).from(table("users")).where([Harmat.Schema.integer("id").in([])]).emit()
    Assert.equal(none.statement, "SELECT name FROM users WHERE 1 = 0")
    Assert.equal(none.params, [])
  end

  it "renders comparisons with their operator" do
    let q = select(["name"]).from(table("users")).where([Harmat.Schema.integer("age").gte(18)]).emit()
    Assert.equal(q.statement, "SELECT name FROM users WHERE age >= ?")
    Assert.equal(q.params, [18])
    let named = select(["name"]).from(table("users")).where([text("name").lt("m")]).emit()
    Assert.equal(named.statement, "SELECT name FROM users WHERE name < ?")
    Assert.equal(named.params, ["m"])
  end

  it "compares nullable columns with plain values" do
    let q = select(["name"]).from(table("users")).where([optInteger("age").eqTo(30)]).emit()
    Assert.equal(q.statement, "SELECT name FROM users WHERE age = ?")
    Assert.equal(q.params, [30])
  end

  it "renders order and limit" do
    let q = select(["name"]).from(table("users")).orderBy("name").limit(10).emit()
    Assert.equal(q.statement, "SELECT name FROM users ORDER BY name LIMIT ?")
    Assert.equal(q.params, [10])
  end

  it "compares text columns to strings" do
    let q = select(["id"]).from(table("users")).where([text("name").eqTo("ada")]).emit()
    Assert.equal(q.statement, "SELECT id FROM users WHERE name = ?")
    Assert.equal(q.params, ["ada"])
  end
end

describe "Harmat.Sql tag" do
  it "passes static text through" do
    let q = sql`SELECT name FROM users WHERE id = ?`
    Assert.equal(q.statement, "SELECT name FROM users WHERE id = ?")
  end

  it "splices holes as params" do
    let age = 30
    let q = sql$`UPDATE users SET age = ${age} WHERE id = ${1}`
    Assert.equal(q.statement, "UPDATE users SET age = ? WHERE id = ?")
    Assert.equal(q.params, [30, 1])
  end

  it "checks optText the same way" do
    let q = select(["id"]).from(table("users")).where([optText("nick").eqTo("al")]).emit()
    Assert.equal(q.statement, "SELECT id FROM users WHERE nick = ?")
    Assert.equal(q.params, ["al"])
  end
end

# Columns are spelled out in full below: beside `storing`, which exists for
# two column kinds, a bare `integer(...)` is resolved to the prelude's
# `integer : Range<Integer> -> Integer` instead of Harmat.Schema's.
describe("Harmat.Odbc statements") do
  let users = table("users")

  it("inserts typed column values as bound parameters") do
    let q = Harmat.Odbc.inserting(users, [Harmat.Schema.text("name").storing("ada"), Harmat.Schema.integer("age").storing(36)])
    Assert.equal(q.statement, "INSERT INTO users (name, age) VALUES (?, CAST(? AS BIGINT))")
    Assert.equal(q.params, ["ada", "36"])
  end

  it("updates the rows a condition selects") do
    let q = Harmat.Odbc.updating(users, [Harmat.Schema.integer("age").storing(37)], [Harmat.Schema.text("name").eqTo("ada")])
    Assert.equal(q.statement, "UPDATE users SET age = CAST(? AS BIGINT) WHERE name = ?")
    Assert.equal(q.params, ["37", "ada"])
  end

  it("deletes and selects with the same conditions") do
    let gone = Harmat.Odbc.deleting(users, [Harmat.Schema.text("name").eqTo("ada"), Harmat.Schema.optInteger("age").isNull])
    Assert.equal(gone.statement, "DELETE FROM users WHERE name = ? AND age IS NULL")
    let listed = Harmat.Odbc.selecting(users, ["id", "name"], [], ["name"])
    Assert.equal(listed.statement, "SELECT id, name FROM users ORDER BY name")
    Assert.equal(listed.params, [])
  end
end

using Harmat.Database, only: [Statement]

record Echo do
  prefix : String = "echo"
end

make Echo, implement: Harmat.Connection do
  foul run(statement: Harmat.Database.Statement) -> Result<Integer, String> = Error("${@prefix} ${statement.statement}")
  foul ask(statement: Harmat.Database.Statement) -> Result<[[String]], String> = Error("${@prefix} ${statement.statement}")
end

foul asked() -> Result<[[String]], String> = Harmat.Connection.ask(Statement { statement: "SELECT 1" })

describe("Harmat.Connection") do
  it("has no database until one is installed") do
    Assert.equal(asked(), Error("no database connected"))
    with Harmat.Connection = Echo {} do
      Assert.equal(asked(), Error("echo SELECT 1"))
    end
    Assert.equal(asked(), Error("no database connected"))
  end
end

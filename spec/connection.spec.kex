using Harmat.Odbc, only: [Statement]

record Echo do
  prefix : String = "echo"
end

make Echo, implement: Harmat.Connection do
  foul run(statement: Harmat.Odbc.Statement) -> Result<Integer, String> = Error("${@prefix} ${statement.statement}")
  foul runMany(statement: Harmat.Odbc.Statement) -> Result<Integer, String> = Error("${@prefix} ${statement.statement} ${statement.params}")
  foul ask(statement: Harmat.Odbc.Statement) -> Result<[[String]], String> = Error("${@prefix} ${statement.statement}")

  # Runs the work as it is: an echo has nothing to keep or undo.
  foul transaction(work: Block<Result<Any, String>>) -> Result<Any, String> do
    return work()
  end
end

foul asked() -> Result<[[String]], String> = Harmat.Connection.ask(Statement { statement: "SELECT 1" })

describe("Harmat.Connection") do
  it("has no database until one is installed") do
    Assert.equal(asked(), Error("no database connected"))
    with Harmat.Connection = Echo {} do
      Assert.equal(asked(), Error("echo SELECT 1"))
    end
    Assert.equal(asked(), Error("no database connected"))
  end
end

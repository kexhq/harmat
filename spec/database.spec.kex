using Harmat.Migration, as: Migration
using Harmat.Table, as: Table
using Harmat.Table, only: [Definition]
using Harmat.Database, as: Database
using Harmat.Database, only: [Direct]
using Harmat.Confined, only: [Confined]
# Without this, `owner == "a" || owner == "b"` is a Bool here: a column
# from `users.textColumn(…)` doesn't bring Harmat.Schema's `||` along
# (kexhq/kex#532).
using Harmat.Schema, only: [Cond]

let users = Table.define :users do |t|
  t.text(:id, primaryKey: true)
  t.text(:email)
  t.text(:owner)
  t.bigint(:credit, default: 0)
end

# Posts refer to users twice: who wrote one, and who last edited it.
let posts = Table.define :posts do |t|
  t.text(:id, primaryKey: true)
  t.belongsTo(:author, :users)
  t.belongsTo(:editor, :users)
  t.text(:title)
end

type Standing = Member | Owner | GroupAdmin

type AccountId = String

# A user as the application knows one: every kind of field a row can fill.
record Account do
  id : AccountId
  email : String = ""
  owner : String = ""
  credit : Integer = 0
  standing : Standing = Member
  verified? : Bool = false
  nickname : String? = None
  tags : [String] = []
  shown : String = "unset"
end

let id = users.textColumn(:id)
let email = users.textColumn(:email)
let owner = users.textColumn(:owner)
let credit = users.wholeColumn(:credit)

# A connection that runs nothing and answers with the SQL it was handed.
record Echoing do
  # A record with no fields is not one a method can be asked of.
  label : String = "echo"
end

make Echoing, implement: Harmat.Connection do
  foul run(statement: Harmat.Odbc.Statement) -> Result<Integer, String> do
    return Error("${statement.statement} ${statement.params}")
  end

  foul runMany(statement: Harmat.Odbc.Statement) -> Result<Integer, String> do
    return Ok(statement.params.first.map { |values| values.count }.or(0))
  end

  foul ask(statement: Harmat.Odbc.Statement) -> Result<[[String]], String> do
    return Error("${statement.statement} ${statement.params}")
  end

  # Runs the work as it is: an echo has nothing to keep or undo.
  foul transaction(work: Block<Result<Any, String>>) -> Result<Any, String> do
    return work()
  end
end

foul dsn(file: String) -> String do
  let driver = ENV.get("HARMAT_SPEC_DRIVER").or("/opt/homebrew/lib/libsqlite3odbc.dylib")
  ENV.get("HARMAT_SPEC_DSN").or("Driver=${driver};Database=${file}")
end

describe("Harmat.Database statements") do
  it("selects every declared column, or the ones named") do
    with Harmat.Connection = Echoing {} do
      Assert.equal(Database.select().from(users).all, Error("SELECT id, email, owner, credit FROM users []"))
      Assert.equal(Database.select([:id, :email]).from(users).where(email == "a@b.co").orderBy([:email]).limit(10).all,
                   Error("SELECT id, email FROM users WHERE email = ? ORDER BY email LIMIT 10 [a@b.co]"))
      Assert.equal(Database.select().from(users).where(owner == "ada").where(credit == 5).first,
                   Error("SELECT id, email, owner, credit FROM users WHERE owner = ? AND credit = ? LIMIT 1 [ada, 5]"))
    end
  end

  it("takes a condition asked of the column itself") do
    with Harmat.Connection = Echoing {} do
      Assert.equal(Database.select([:id]).from(users).where(owner == "ada").where(credit == 5).all,
                   Error("SELECT id FROM users WHERE owner = ? AND credit = ? [ada, 5]"))
    end
  end

  it("batches inserts as one statement with values grouped by column") do
    with Harmat.Connection = Echoing {} do
      Assert.equal(
        Database.insertAll(users, [
          {id: "u1", email: "a@x", owner: "ada"},
          {id: "u2", email: "b@x", owner: "bob"}
        ]),
        Ok(2)
      )
      Assert.truthy(Database.insertAll(users, [{id: "u1"}, {email: "b@x"}]).error?)
    end
  end

  it("asks for a column among several values") do
    with Harmat.Connection = Echoing {} do
      let among = Database.select([:id]).from(users)
        .where(email.in(["a@b.co", "c@d.co"]))
        .where(credit == 5)
        .all
      Assert.equal(among, Error("SELECT id FROM users WHERE email IN (?, ?) AND credit = ? [a@b.co, c@d.co, 5]"))
      Assert.equal(Database.select([:id]).from(users).where(credit.in([1, 2, 3])).all,
                   Error("SELECT id FROM users WHERE credit IN (?, ?, ?) [1, 2, 3]"))
      Assert.equal(Database.delete(users).where(id.in([])).run,
                   Error("DELETE FROM users WHERE 1 = 0 []"))
    end
  end

  it("compares a column with a value, by number or by text, with operators") do
    with Harmat.Connection = Echoing {} do
      Assert.equal(Database.select([:id]).from(users).where(credit > 5).where(credit <= 10).all,
                   Error("SELECT id FROM users WHERE credit > CAST(? AS BIGINT) AND credit <= CAST(? AS BIGINT) [5, 10]"))
      Assert.equal(Database.select([:id]).from(users)
                     .where(email >= "m")
                     .where(email < "n")
                     .all,
                   Error("SELECT id FROM users WHERE email >= ? AND email < ? [m, n]"))
      Assert.equal(Database.select([:id]).from(users).where(owner != "ada").where(credit != 0).all,
                   Error("SELECT id FROM users WHERE owner <> ? AND credit <> CAST(? AS BIGINT) [ada, 0]"))
    end
  end

  it("joins conditions with || and &&, && binding tighter") do
    with Harmat.Connection = Echoing {} do
      Assert.equal(Database.select([:id]).from(users).where(owner == "ada" || credit > 100).all,
                   Error("SELECT id FROM users WHERE (owner = ? OR credit > CAST(? AS BIGINT)) [ada, 100]"))
      Assert.equal(Database.select([:id]).from(users).where(owner == "ada" || owner == "bob" && credit > 5).where(email != "").all,
                   Error("SELECT id FROM users WHERE (owner = ? OR (owner = ? AND credit > CAST(? AS BIGINT))) AND email <> ? [ada, bob, 5, ]"))
      Assert.equal(Database.select([:id]).from(users).where(owner == "a" || owner == "b" || owner == "c").all,
                   Error("SELECT id FROM users WHERE (owner = ? OR owner = ? OR owner = ?) [a, b, c]"))
    end
  end

  it("spells the everyday queries short: every row, one by its key, and a has-many for many rows") do
    with Harmat.Connection = Echoing {} do
      Assert.equal(Database.all(users), Error("SELECT id, email, owner, credit FROM users []"))
      Assert.equal(Database.find(users, "u1"), Error("SELECT id, email, owner, credit FROM users WHERE id = ? LIMIT 1 [u1]"))
      Assert.equal(
        Database.belongingTo(posts, users, ["u1", "u2", "u1"], via: :author_id, orderBy: [:title]),
        Error("SELECT id, author_id, editor_id, title FROM posts WHERE author_id IN (?, ?) ORDER BY title [u1, u2]")
      )
      Assert.equal(Database.belongingTo(posts, users, [], via: :author_id), Ok({}))
      Assert.equal(
        Database.belongingTo(posts, users, ["u1"], via: :editor),
        Error("SELECT id, author_id, editor_id, title FROM posts WHERE editor_id IN (?) [u1]")
      )
      Assert.equal(
        Database.belongingTo(posts, users, ["u1"]),
        Error("author_id and editor_id of posts both refer to users: say which with `via:`")
      )
      Assert.equal(Database.belongingTo(users, posts, ["p1"]), Error("users declares no column referring to posts"))
    end
  end

  it("narrows by a map of column to value, each written as its column stores it") do
    with Harmat.Connection = Echoing {} do
      Assert.equal(
        Database.select([:id]).from(users).by({owner: "ada", credit: 5}).all,
        Error("SELECT id FROM users WHERE credit = ? AND owner = ? [5, ada]")
      )
      Assert.equal(Database.findBy(users, {email: "a@b.co"}), Error("SELECT id, email, owner, credit FROM users WHERE email = ? LIMIT 1 [a@b.co]"))
      Assert.equal(
        Database.insert(users).record(Account { id: "u9", email: "e", credit: 2, standing: GroupAdmin }, extra: {owner: GroupAdmin}).run,
        Error("INSERT INTO users (credit, email, id, owner) VALUES (CAST(? AS BIGINT), ?, ?, ?) [2, e, u9, group_admin]")
      )
      Assert.equal(
        Database.insert(users).values({id: "stale"})
          .record(Account { id: "u9", email: "e", credit: 2, standing: GroupAdmin }, extra: {owner: GroupAdmin}).run,
        Error("INSERT INTO users (credit, email, id, owner) VALUES (CAST(? AS BIGINT), ?, ?, ?) [2, e, u9, group_admin]")
      )
      # A constructor is written by its name in snake case.
      Assert.equal(Database.select([:id]).from(users).by({owner: GroupAdmin}).all, Error("SELECT id FROM users WHERE owner = ? [group_admin]"))
      Assert.equal(Database.update(users).set({credit: 1}).by({id: "u1"}).run, Error("UPDATE users SET credit = CAST(? AS BIGINT) WHERE id = ? [1, u1]"))
      Assert.equal(Database.delete(users).by({id: "u1"}).run, Error("DELETE FROM users WHERE id = ? [u1]"))
      # A column the table does not declare matches nothing.
      Assert.equal(Database.select([:id]).from(users).by({nobody: 1}).all, Error("SELECT id FROM users WHERE 1 = 0 []"))
    end
  end

  it("fills a record from a row, each field by its own type") do
    let row = {
      "id": "u1",
      "email": "ada@example.com",
      "credit": "90000000000",
      "standing": "group_admin",
      "verified": "TRUE",
      "nickname": "",
      "tags": "a, b,,c",
      "display": "Ada"
    }
    Assert.equal(Harmat.Database.decoded(row, Account, {"shown": "display"}), Ok(Account {
      id: "u1",
      email: "ada@example.com",
      credit: 90000000000,
      standing: GroupAdmin,
      verified?: true,
      nickname: None,
      tags: ["a", "b", "c"],
      shown: "Ada"
    }))
    # What a column does not say, or cannot, the field's default stands for.
    Assert.equal(
      Harmat.Database.decoded({"id": "u2", "credit": "lots", "standing": "king", "nickname": "Al"}, Account, {}),
      Ok(Account { id: "u2", nickname: Just("Al") })
    )
    # A required field no column fills is an error, not a record.
    Assert.truthy(Harmat.Database.decoded({"email": "a@b.co"}, Account, {}).error?)
  end

  it("counts rows, in all or for each value of a column") do
    with Harmat.Connection = Echoing {} do
      Assert.equal(Database.select().from(users).where(credit > 0).orderBy([:id]).limit(3).count,
                   Error("SELECT COUNT(*) FROM users WHERE credit > CAST(? AS BIGINT) [0]"))
      Assert.equal(Database.select().from(users).where(owner == "ada").countBy(:email),
                   Error("SELECT email, COUNT(*) FROM users WHERE owner = ? GROUP BY email [ada]"))
      Assert.equal(Database.select().count,
                   Error("select() was not given a table: add .from(table)"))
    end
  end

  it("tells the logger each statement, as a line Rails would print") do
    let found = Harmat.Odbc.Statement {
      statement: "SELECT id, email FROM users WHERE email = ? AND owner = ?",
      params: ["ada@example.com", "pbkdf2-sha256$600000$salt$key"]
    }
    Assert.equal(
      Harmat.Log.line(found, 412, "1 row", false),
      "  users (0.4ms)  SELECT id, email FROM users WHERE email = ? AND owner = ?  [\"ada@example.com\", [FILTERED]]  1 row"
    )
    let counted = Harmat.Odbc.Statement { statement: "SELECT COUNT(*) FROM users" }
    Assert.equal(Harmat.Log.line(counted, 12500, "3 rows", false), "  users (12.5ms)  SELECT COUNT(*) FROM users  3 rows")
    let digest = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    let removed = Harmat.Odbc.Statement { statement: "DELETE FROM sessions WHERE id = ?", params: [digest] }
    Assert.equal(Harmat.Log.line(removed, 900, "1 changed", false), "  sessions (0.9ms)  DELETE FROM sessions WHERE id = ?  [[FILTERED]]  1 changed")
    # Plain when asked to be.
    Assert.falsy(Harmat.Log.line(found, 412, "1 row", false).contains?("["+"1;"))
    # A query runs the same with a logger installed.
    with Harmat.Connection = Echoing {} do
      with Harmat.Logger = Harmat.Log.Console { shown?: false } do
        Assert.equal(Database.select([:id]).from(users).where(id == "u1").all,
                     Error("SELECT id FROM users WHERE id = ? [u1]"))
      end
    end
  end

  it("orders largest first") do
    with Harmat.Connection = Echoing {} do
      Assert.equal(Database.select([:id]).from(users).orderBy(descending: [:credit, :id]).limit(3).all,
                   Error("SELECT id FROM users ORDER BY credit DESC, id DESC LIMIT 3 []"))
      Assert.equal(Database.select([:id]).from(users).orderBy([:owner], descending: [:credit]).all,
                   Error("SELECT id FROM users ORDER BY owner, credit DESC []"))
    end
  end

  it("inserts a row given by column name, each value as its column stores it") do
    with Harmat.Connection = Echoing {} do
      Assert.equal(Database.insert(users).values({id: "u1", email: "a@b.co", credit: 7}).run,
                   Error("INSERT INTO users (credit, email, id) VALUES (CAST(? AS BIGINT), ?, ?) [7, a@b.co, u1]"))
    end
  end

  it("updates and deletes the rows a condition selects") do
    with Harmat.Connection = Echoing {} do
      Assert.equal(Database.update(users).set({email: "new@b.co"}).where(id == "u1").run, Error("UPDATE users SET email = ? WHERE id = ? [new@b.co, u1]"))
      Assert.equal(Database.delete(users).where(id == "u1").run, Error("DELETE FROM users WHERE id = ? [u1]"))
    end
  end

  it("refuses a column the table does not declare, and a select with no table") do
    with Harmat.Connection = Echoing {} do
      Assert.equal(Database.insert(users).values({nickname: "x"}).run, Error("users has no column nickname"))
      Assert.equal(Database.select().all, Error("select() was not given a table: add .from(table)"))
    end
  end

  it("carries a confining condition on every statement") do
    with Harmat.Connection = Echoing {} do
      let hers : Confined = Database.within(owner == "ada")
      Assert.equal(hers.select().from(users).where(id == "u1").all, Error("SELECT id, email, owner, credit FROM users WHERE owner = ? AND id = ? [ada, u1]"))
      Assert.equal(hers.update(users).set({credit: 1}).where(id == "u1").run, Error("UPDATE users SET credit = CAST(? AS BIGINT) WHERE owner = ? AND id = ? [1, ada, u1]"))
      Assert.equal(hers.delete(users).where(id == "u1").run, Error("DELETE FROM users WHERE owner = ? AND id = ? [ada, u1]"))
    end
  end
end

describe("Harmat.Database against a database") do
  it("reads back what it wrote, as rows keyed by column") do
    let file = "harmat_db_${BEAM.erlang.system_time(:millisecond)}.db"
    Harmat.Odbc.sideload(".odbc")
    let connection = Harmat.Odbc.connect(dsn(file)).try
    # A database shared by every run, as on PostgreSQL, keeps the last one's.
    Harmat.Odbc.execute(connection, Harmat.Odbc.plain("DROP TABLE IF EXISTS users")).try
    Harmat.Odbc.execute(connection, Harmat.Odbc.plain("CREATE TABLE users (id TEXT PRIMARY KEY, email TEXT NOT NULL, owner TEXT NOT NULL, credit BIGINT NOT NULL DEFAULT 0)")).try
    with Harmat.Connection = Direct { connection: connection } do
      Assert.equal(Database.insert(users).values({id: "u1", email: "ada@example.com", owner: "ada", credit: 90000000000}).run, Ok(1))
      Assert.equal(Database.insert(users).values({id: "u2", email: "bob@example.com", owner: "bob"}).run, Ok(1))
      Assert.equal(Database.select().from(users).orderBy([:id]).all, Ok([
        {"id": "u1", "email": "ada@example.com", "owner": "ada", "credit": "90000000000"},
        {"id": "u2", "email": "bob@example.com", "owner": "bob", "credit": "0"}
      ]))
      Assert.equal(Database.select([:email]).from(users).where(id == "u2").first, Ok(Just({"email": "bob@example.com"})))
      Assert.equal(Database.select().from(users).where(id == "nobody").first, Ok(None))

      let hers : Confined = Database.within(owner == "ada")
      Assert.equal(hers.update(users).set({credit: 5}).where(id == "u2").run, Ok(0))
      Assert.equal(hers.delete(users).where(id == "u2").run, Ok(0))
      Assert.equal(hers.update(users).set({credit: 5}).where(id == "u1").run, Ok(1))
      Assert.equal(hers.select([:credit]).from(users).all, Ok([{"credit": "5"}]))
      Assert.equal(Database.delete(users).where(id == "u1").run, Ok(1))

      Database.insert(users)
        .values({
          id: "u3",
          email: "eve@example.com",
          owner: "bob",
          credit: 7
        })
        .run
      Assert.equal(Database.select().from(users).count, Ok(2))
      Assert.equal(Database.select().from(users).where(credit > 5).count, Ok(1))
      Assert.equal(Database.select().from(users).where(owner == "nobody").count, Ok(0))
      Assert.equal(Database.select().from(users).countBy(:owner), Ok({"bob": 2}))
      Assert.equal(Database.select().from(users)
                     .where(credit < 5)
                     .countBy(:email),
                   Ok({"bob@example.com": 1}))

      Assert.equal(Database.all(users).map { |rows| rows.count }, Ok(2))
      Assert.equal(Database.all(users, as: Account).map { |accounts| accounts.map(&.id) }, Ok(["u2", "u3"]))
      Assert.equal(Database.find(users, "u3").map { |row| row.map { |found| found.get("email").or("") } }, Ok(Just("eve@example.com")))
      Assert.equal(Database.find(users, "nobody"), Ok(None))
      Assert.equal(Database.findBy(users, {owner: "bob", credit: 7}).map { |row| row.map { |found| found.get("id").or("") } }, Ok(Just("u3")))
      Assert.equal(
        Database.select().from(users).by({owner: "bob"}).orderBy([:id]).all(as: Account).map { |found| found.map { |account| "${account.id} ${account.credit}" } },
        Ok(["u2 0", "u3 7"])
      )
      Assert.equal(Database.select().from(users).by({id: "u3"}).first(as: Account).map { |found| found.map { |account| account.email } }, Ok(Just("eve@example.com")))
      Assert.equal(Database.find(users, "u3", as: Account).map { |found| found.map { |account| account.credit } }, Ok(Just(7)))
      Assert.equal(Database.select().from(users).by({owner: "bob"}).orderBy([:id]).pluck(:email), Ok(["bob@example.com", "eve@example.com"]))
      Assert.equal(Database.exists?(users, {owner: "bob"}), Ok(true))
      Assert.equal(Database.exists?(users, {owner: "nobody"}), Ok(false))
      Assert.equal(Database.insertAll(users, [{id: "u5", email: "f@x", owner: "f"}, {id: "u6", email: "g@x", owner: "g"}]), Ok(2))
      Assert.truthy(Database.insertAll(users, [{id: "u7", email: "h@x", owner: "h"}, {id: "u5", email: "again", owner: "f"}]).error?)
      Assert.equal(Database.find(users, "u7").map { |found| found.set? }, Ok(true))
      # A record goes in field by field; what the table has no column for is left out.
      let ada = Account { id: "u4", email: "ada@example.com", credit: 3, standing: Owner, tags: ["x"] }
      Assert.equal(Database.insert(users).record(ada, extra: {owner: "ada"}).run, Ok(1))
      Assert.equal(Database.find(users, "u4", as: Account).map { |found| found.map { |account| "${account.email} ${account.credit} ${account.owner}" } }, Ok(Just("ada@example.com 3 ada")))
      Assert.equal(Database.findBy(users, {email: "eve@example.com"}, as: Account).map { |found| found.map { |account| account.id } }, Ok(Just("u3")))

      # Each user's posts, in one query, by the user they belong to.
      Harmat.Odbc.execute(connection, Harmat.Odbc.plain("CREATE TABLE posts (id TEXT PRIMARY KEY, author_id TEXT NOT NULL, editor_id TEXT NOT NULL, title TEXT NOT NULL)")).try
      [("p1", "u2", "b"), ("p2", "u3", "a"), ("p3", "u2", "a")].each { |post|
        match post do
          (key, author, title) => Database.insert(posts).values({id: key, author_id: author, editor_id: "u3", title: title}).run
        end
      }
      let written = Database.belongingTo(posts, users, ["u2", "u3", "nobody"], via: :author_id, orderBy: [:title]).try
      Assert.equal(written.get("u2").or([]).map { |row| row.get("id").or("") }, ["p3", "p1"])
      Assert.equal(written.get("u3").or([]).map { |row| row.get("id").or("") }, ["p2"])
      Assert.equal(written.get("nobody"), None)
    end
    FS.File.delete(file)
  end

  it("keeps a transaction's statements together: all of them, or none") do
    let file = "harmat_tx_${BEAM.erlang.system_time(:millisecond)}.db"
    Harmat.Odbc.sideload(".odbc")
    let connection = Harmat.Odbc.connect(dsn(file)).try
    # On PostgreSQL every spec shares one database: the spec before this one
    # leaves its table behind.
    Harmat.Odbc.execute(connection, Harmat.Odbc.plain("DROP TABLE IF EXISTS users")).try
    Harmat.Odbc.execute(connection, Harmat.Odbc.plain("CREATE TABLE users (id TEXT PRIMARY KEY, email TEXT NOT NULL, owner TEXT NOT NULL, credit BIGINT NOT NULL DEFAULT 0)")).try
    with Harmat.Connection = Direct { connection: connection } do
      let row = { |id| {id: id, email: "${id}@example.com", owner: "ada"} }

      # Answering Ok keeps every statement.
      let kept = Database.transaction do
        Database.insert(users).values(row("u1")).run.try
        Database.insert(users).values(row("u2")).run.try
        Ok("both")
      end
      Assert.equal(kept, Ok("both"))
      Assert.equal(Database.select().from(users).count, Ok(2))

      # Answering Error undoes them; so does a failure part-way, by `.try`.
      let refused = Database.transaction do
        Database.insert(users).values(row("u3")).run.try
        Error("changed my mind")
      end
      Assert.equal(refused, Error("changed my mind"))
      let broken = Database.transaction do
        Database.insert(users).values(row("u4")).run.try
        Database.insert(users).values(row("u1")).run.try
        Ok("never")
      end
      Assert.truthy(broken.error?)
      Assert.equal(Database.select([:id]).from(users).orderBy([:id]).all, Ok([{"id": "u1"}, {"id": "u2"}]))

      # A transaction inside one joins it: undone with it.
      let nested = Database.transaction do
        Database.transaction do
          Database.insert(users).values(row("u5")).run
        end
        Error("all of it")
      end
      Assert.equal(nested, Error("all of it"))
      Assert.equal(Database.select().from(users).count, Ok(2))

      # A statement on its own is kept by itself.
      Database.delete(users).where(id == "u2").run.try
    end

    # What was kept is there for another connection.
    let other = Harmat.Odbc.connect(dsn(file)).try
    Assert.equal(Harmat.Odbc.query(other, Harmat.Odbc.plain("SELECT id FROM users")), Ok([["u1"]]))
    FS.File.delete(file)
  end

  it("sends a query once inside cache, until something changes") do
    let file = "harmat_cache_${BEAM.erlang.system_time(:millisecond)}.db"
    Harmat.Odbc.sideload(".odbc")
    let connection = Harmat.Odbc.connect(dsn(file)).try
    Harmat.Odbc.execute(connection, Harmat.Odbc.plain("DROP TABLE IF EXISTS users")).try
    Harmat.Odbc.execute(connection, Harmat.Odbc.plain("CREATE TABLE users (id TEXT PRIMARY KEY, email TEXT NOT NULL, owner TEXT NOT NULL, credit BIGINT NOT NULL DEFAULT 0)")).try
    BEAM.erlang.put(:told, [])
    with Harmat.Connection = Direct { connection: connection } do
      with Harmat.Logger = Telling {} do
        let row = { |id| {id: id, email: "${id}@example.com", owner: "ada"} }
        let ada = { Database.select([:id]).from(users).where(owner == "ada").orderBy([:id]).pluck(:id) }
        Database.insert(users).values(row("u1")).run.try
        told()

        # Outside it, every query is sent.
        ada()
        ada()
        Assert.equal(told(), ["1 row", "1 row"])

        Database.cache do
          let before = Database.tally()
          Assert.equal(ada(), Ok(["u1"]))
          Assert.equal(ada(), Ok(["u1"]))
          Assert.equal(told(), ["1 row", "1 row (cache)"])
          # The tally says so too: one sent, one from the cache.
          let cost = Database.tally().since(before)
          Assert.equal((cost.sent, cost.cached), (1, 1))

          # A change empties it: what is read after is read again.
          Database.insert(users).values(row("u2")).run.try
          Assert.equal(ada(), Ok(["u1", "u2"]))
          Assert.equal(told(), ["1 changed", "2 rows"])

          # So does a transaction, kept or not.
          Database.transaction do
            Database.update(users).set({credit: 5}).where(id == "u1").run
          end
          ada()
          Assert.equal(told(), ["", "1 changed", "", "2 rows"])

          # A cache inside one is that one.
          Database.cache do
            ada()
          end
          Assert.equal(told(), ["2 rows (cache)"])
          Assert.truthy(Database.caching?())
        end
        Assert.falsy(Database.caching?())

        # A failure inside it does not leave the process caching.
        trying do
          Database.cache do
            ada()
            # Something raised, not an Error a block answers.
            1 / ([1].count - 1)
          end
        rescue
          reason => BEAM.erlang.put(:rescued, reason)
        end
        # It still reaches whoever was waiting for it.
        Assert.truthy(BEAM.erlang.get(:rescued) != :undefined)
        Assert.falsy(Database.caching?())
        told()
        ada()
        ada()
        Assert.equal(told(), ["2 rows", "2 rows"])
      end
    end
    FS.File.delete(file)
  end
end

# A logger that keeps how each statement went, for `told`.
record Telling do
  label : String = "telling"
end

make Telling, implement: Harmat.Logger do
  foul queried(statement: Harmat.Odbc.Statement, micros: Integer, outcome: String) -> Void do
    let held : [String] = BEAM.erlang.get(:told)
    BEAM.erlang.put(:told, held + [outcome])
  end
end

# How each statement went since the last time this was asked.
foul told -> [String] do
  let held : [String] = BEAM.erlang.get(:told)
  BEAM.erlang.put(:told, [])
  return held
end

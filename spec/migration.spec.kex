using Harmat.Migration, as: Migration
using Harmat.Migration, only: [createTable, dropTable, addColumn, addIndex, changeColumn, execute]
using Harmat.Sql, only: [sql]
using Harmat.Odbc, only: [detect, SQLite, PostgreSQL]

# The database this spec runs against: a SQLite file, through the ODBC
# driver HARMAT_SPEC_DRIVER names (a path, or a name unixODBC knows, such as
# SQLite3) or the one Homebrew installs. HARMAT_SPEC_DSN names any other
# database instead.
foul dsn(file: String) -> String do
  let driver = ENV.get("HARMAT_SPEC_DRIVER").or("/opt/homebrew/lib/libsqlite3odbc.dylib")
  ENV.get("HARMAT_SPEC_DSN").or("Driver=${driver};Database=${file}")
end

let createUsers = Migration.define :create_users do
  createTable(:users) do |t|
    t.text(:id, primaryKey: true)
    t.text(:email)
    t.bigint(:credit, default: 0)
    t.text(:role, default: "member", oneOf: ["member", "admin"])
    t.boolean(:active, default: true)
    t.text(:nickname, nullable: true)
  end
  addIndex(:users, [:email], unique: true)
end

let addNames = Migration.define :add_names, follows: :create_users do
  addColumn(:users) do |t| t.text(:name, default: "it's") end
end

let addIndexes = Migration.define :add_indexes, follows: :add_names do
  addIndex(:users, [:role, :name])
end

let allowOwners = Migration.define :allow_owners, follows: :add_indexes do
  changeColumn(:users) do |t|
    t.text(:role, default: "member", oneOf: ["member", "admin"])
    t.text(:role, default: "member", oneOf: ["member", "admin", "owner"])
  end
end

let names(steps: [Harmat.Migration.Migration]) -> [String] = steps.map { |step| step.name }

describe("Harmat.Migration DSL") do
  it("renders a table as standard SQL") do
    Assert.equal(Harmat.Migration.statements(createUsers), [
      "CREATE TABLE users (\n  id TEXT PRIMARY KEY,\n  email TEXT NOT NULL,\n  credit BIGINT NOT NULL DEFAULT 0,\n  role TEXT NOT NULL DEFAULT 'member' CHECK (role IN ('member', 'admin')),\n  active BOOLEAN NOT NULL DEFAULT TRUE,\n  nickname TEXT\n)",
      "CREATE UNIQUE INDEX users_email_index ON users (email)"
    ])
  end

  it("escapes a text default") do
    Assert.equal(Harmat.Migration.statements(addNames), ["ALTER TABLE users ADD COLUMN name TEXT NOT NULL DEFAULT 'it''s'"])
  end
end

describe("Harmat.Migration rollback") do
  it("works out the opposite of each operation, last first") do
    Assert.equal(Harmat.Migration.undoing(createUsers), Ok(["DROP INDEX users_email_index", "DROP TABLE users"]))
    Assert.equal(Harmat.Migration.undoing(addNames), Ok(["ALTER TABLE users DROP COLUMN name"]))
    Assert.equal(Harmat.Migration.undoing(addIndexes), Ok(["DROP INDEX users_role_name_index"]))
  end

  it("recreates a dropped table when it was told the columns") do
    let retire = Migration.define :retire_users, follows: :add_indexes do
      dropTable(:users) do |t|
        t.text(:id, primaryKey: true)
      end
    end
    Assert.equal(Harmat.Migration.undoing(retire), Ok(["CREATE TABLE users (\n  id TEXT PRIMARY KEY\n)"]))
  end

  it("refuses what threw information away") do
    let forgetful = Migration.define :forget_users, follows: :add_indexes do
      dropTable(:users)
    end
    Assert.truthy(Harmat.Migration.undoing(forgetful).error?)
    let raw = Migration.define :raw, follows: :add_indexes do
      execute(sql`UPDATE users SET role = 'member'`)
    end
    Assert.truthy(Harmat.Migration.undoing(raw).error?)
    let paired = Migration.define :paired, follows: :add_indexes do
      execute(
        sql`
          UPDATE users
          SET credit = credit + 1`,
        undo: sql`UPDATE users SET credit = credit - 1`
      )
    end
    Assert.equal(Harmat.Migration.undoing(paired), Ok(["UPDATE users SET credit = credit - 1"]))
    Assert.equal(Harmat.Migration.statements(paired), ["UPDATE users\nSET credit = credit + 1"])
  end
end

describe("Harmat.Migration changeColumn") do
  it("alters a column in place on PostgreSQL, and back on rollback") do
    Assert.equal(Harmat.Migration.statements(allowOwners, PostgreSQL), [
      "ALTER TABLE users DROP CONSTRAINT users_role_check, ADD CONSTRAINT users_role_check CHECK (role IN ('member', 'admin', 'owner'))"
    ])
    Assert.equal(Harmat.Migration.undoing(allowOwners, PostgreSQL), Ok([
      "ALTER TABLE users DROP CONSTRAINT users_role_check, ADD CONSTRAINT users_role_check CHECK (role IN ('member', 'admin'))"
    ]))
    let loosened = Migration.define :loosen, follows: :add_indexes do
      changeColumn(:users) do |t|
        t.bigint(:credit, default: 0)
        t.text(:credit, nullable: true)
      end
    end
    Assert.equal(Harmat.Migration.statements(loosened, PostgreSQL), [
      "ALTER TABLE users ALTER COLUMN credit TYPE TEXT USING credit::TEXT, ALTER COLUMN credit DROP NOT NULL, ALTER COLUMN credit DROP DEFAULT"
    ])
    Assert.equal(Harmat.Migration.irreversible([createUsers, addNames, addIndexes, allowOwners]), [])
  end
end

describe("Harmat dialects") do
  it("reads the database from its connection string") do
    Assert.equal(
      detect("Driver=/opt/homebrew/lib/libsqlite3odbc.dylib;Database=db/development.sqlite3"),
      SQLite
    )
    Assert.equal(detect("Driver=SQLite3;Database=db/test.sqlite3"), SQLite)
    Assert.equal(
      detect("Driver={PostgreSQL Unicode};Server=db;Port=5432;Database=app;Uid=app;Pwd=secret"),
      PostgreSQL
    )
    Assert.equal(detect("Driver=/opt/homebrew/lib/psqlodbcw.so;Server=db;Database=app"), PostgreSQL)
    Assert.equal(detect("Driver={SQL Server};Server=db"), SQLite)
  end

  it("renders a serial primary key per database") do
    let widgets = Migration.define :create_widgets do
      createTable(:widgets) do |t|
        t.serial(:id)
        t.text(:name)
      end
    end
    Assert.equal(
      Harmat.Migration.statements(widgets),
      ["CREATE TABLE widgets (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  name TEXT NOT NULL\n)"]
    )
    Assert.equal(
      Harmat.Migration.statements(widgets, PostgreSQL),
      ["CREATE TABLE widgets (\n  id INTEGER PRIMARY KEY GENERATED ALWAYS AS IDENTITY,\n  name TEXT NOT NULL\n)"]
    )
    Assert.equal(Harmat.Migration.undoing(widgets, PostgreSQL), Ok(["DROP TABLE widgets"]))
  end
end

let addAvatars = Migration.define :add_avatars, follows: :create_users do
  addColumn(:users) do |t| t.text(:avatar, default: "") end
end

describe("Harmat.Migration history") do
  it("orders by what follows what, whatever order the list is in") do
    Assert.equal(Harmat.Migration.ordered([addIndexes, createUsers, addNames]).map(~names), Ok(["create_users", "add_names", "add_indexes"]))
    Assert.equal(Harmat.Migration.head([addIndexes, createUsers, addNames]), Ok("add_indexes"))
  end

  it("reports two heads, and how to join them") do
    Assert.equal(Harmat.Migration.heads([createUsers, addNames, addAvatars]), ["add_names", "add_avatars"])
    Assert.equal(Harmat.Migration.ordered([createUsers, addNames, addAvatars]), Error("the history has 2 heads: \"add_names\" and \"add_avatars\". This is what merging branches that each added a migration looks like — join them with merge(\"merge_add_names_and_add_avatars\", [\"add_names\", \"add_avatars\"])"))
  end

  it("is whole again once a merge names both heads") do
    let joined = Migration.merge(:merge_names_and_avatars, [:add_names, :add_avatars])
    let later = Migration.define :later, follows: :merge_names_and_avatars do
      addIndex(:users, [:avatar])
    end
    let history = [later, joined, addAvatars, addNames, createUsers]
    Assert.equal(Harmat.Migration.ordered(history).map(~names), Ok(["create_users", "add_avatars", "add_names", "merge_names_and_avatars", "later"]))
    Assert.equal(Harmat.Migration.head(history), Ok("later"))
    Assert.equal(Harmat.Migration.irreversible(history), [])
  end

  it("refuses a parent that is not in the list, two roots, and repeats") do
    Assert.truthy(Harmat.Migration.ordered([createUsers, addIndexes]).error?)
    Assert.truthy(Harmat.Migration.ordered([createUsers, Harmat.Migration.Migration { name: "other" }]).error?)
    Assert.truthy(Harmat.Migration.ordered([createUsers, createUsers]).error?)
  end

  it("refuses a loop") do
    let first = Harmat.Migration.Migration { name: "a", parents: ["b"] }
    let second = Harmat.Migration.Migration { name: "b", parents: ["a"] }
    Assert.truthy(Harmat.Migration.ordered([first, second]).error?)
    Assert.truthy(Harmat.Migration.ordered([createUsers, first, second]).error?)
  end
end

describe("Harmat.Migration against a database") do
  it("runs each migration once, a merged branch afterwards, and rolls back") do
    let file = "harmat_spec_${BEAM.erlang.system_time(:millisecond)}.db"
    Harmat.Odbc.sideload(".odbc")
    let connection = Harmat.Odbc.connect(dsn(file)).try

    Assert.equal(Harmat.Migration.migrate(connection, [createUsers, addNames]), Ok(["create_users", "add_names"]))
    Assert.equal(Harmat.Migration.migrate(connection, [createUsers, addNames]), Ok([]))

    # Another branch added `add_avatars`; the merge joined the two heads. This
    # database already ran `add_names`, so only the newcomers are left.
    let history = [createUsers, addNames, addAvatars, Migration.merge(:merge_names_and_avatars, [:add_names, :add_avatars])]
    Assert.equal(Harmat.Migration.migrate(connection, history), Ok(["add_avatars", "merge_names_and_avatars"]))
    Assert.equal(Harmat.Migration.recorded(connection).map { |done| done.sort }, Ok(["add_avatars", "add_names", "create_users", "merge_names_and_avatars"]))

    # Newest first by the history, not by when each happened to run: the
    # merge, then both of its parents.
    Assert.equal(Harmat.Migration.rollback(connection, history), Ok(["merge_names_and_avatars"]))
    Assert.equal(Harmat.Migration.rollback(connection, history, 2), Ok(["add_names", "add_avatars"]))
    Assert.equal(Harmat.Migration.rollback(connection, history, 5), Ok(["create_users"]))
    Assert.equal(Harmat.Migration.rollback(connection, history), Ok([]))
    Assert.equal(Harmat.Migration.migrate(connection, history).map { |done| done.count }, Ok(4))
    FS.File.delete(file)
  end

  it("changes a column, keeping the rows and indexes, and refuses rows it would not let in") do
    let file = "harmat_change_${BEAM.erlang.system_time(:millisecond)}.db"
    Harmat.Odbc.sideload(".odbc")
    let connection = Harmat.Odbc.connect(dsn(file)).try
    let history = [createUsers, addNames, addIndexes]
    Harmat.Migration.migrate(connection, history).try
    let table = Harmat.Schema.table("users")
    let person = { |id, role|
      Harmat.Odbc.inserting(table, [
        ("id", Harmat.Schema.Text(id)),
        ("email", Harmat.Schema.Text("${id}@example.com")),
        ("role", Harmat.Schema.Text(role))
      ])
    }
    Assert.equal(Harmat.Odbc.execute(connection, person("ada", "admin")), Ok(1))
    Assert.truthy(Harmat.Odbc.execute(connection, person("bob", "owner")).error?)

    Assert.equal(Harmat.Migration.migrate(connection, history + [allowOwners]), Ok(["allow_owners"]))
    Assert.equal(Harmat.Odbc.execute(connection, person("bob", "owner")), Ok(1))
    let listed = Harmat.Odbc.selecting(table, ["id", "role", "name"], [], ["id"])
    Assert.equal(Harmat.Odbc.query(connection, listed), Ok([["ada", "admin", "it's"], ["bob", "owner", "it's"]]))
    # The indexes came back with the table: the email is unique still.
    Assert.truthy(Harmat.Odbc.execute(connection, person("ada", "member")).error?)
    let indexes = match Harmat.Odbc.dialect(connection) do
      SQLite => Harmat.Odbc.plain("SELECT name FROM sqlite_master WHERE type = 'index' AND tbl_name = 'users' AND sql IS NOT NULL ORDER BY name")
      PostgreSQL => Harmat.Odbc.plain("SELECT indexname FROM pg_indexes WHERE tablename = 'users' AND indexname LIKE '%_index' ORDER BY indexname")
    end
    Assert.equal(Harmat.Odbc.query(connection, indexes), Ok([["users_email_index"], ["users_role_name_index"]]))

    # Bob is an owner, which the column as it was does not let in: the
    # rollback fails, and the table is as it was before it was tried.
    Assert.truthy(Harmat.Migration.rollback(connection, history + [allowOwners]).error?)
    Assert.equal(Harmat.Odbc.query(connection, listed).map { |rows| rows.count }, Ok(2))
    Assert.equal(Harmat.Migration.recorded(connection).map { |done| done.contains?("allow_owners") }, Ok(true))
    let demoted = Harmat.Odbc.updating(table, [("role", Harmat.Schema.Text("admin"))], [Harmat.Schema.text("id").eqTo("bob")])
    Harmat.Odbc.execute(connection, demoted).try
    Assert.equal(Harmat.Migration.rollback(connection, history + [allowOwners]), Ok(["allow_owners"]))
    Assert.truthy(Harmat.Odbc.execute(connection, person("eve", "owner")).error?)
    Assert.equal(Harmat.Odbc.query(connection, listed).map { |rows| rows.count }, Ok(2))
    FS.File.delete(file)
  end

  it("assigns serial primary keys on this database") do
    let file = "harmat_serial_${BEAM.erlang.system_time(:millisecond)}.db"
    Harmat.Odbc.sideload(".odbc")
    let connection = Harmat.Odbc.connect(dsn(file)).try
    let widgets = Migration.define :create_widgets do
      createTable(:widgets) do |t|
        t.serial(:id)
        t.text(:name)
      end
    end
    Assert.equal(Harmat.Migration.migrate(connection, [widgets]), Ok(["create_widgets"]))
    let table = Harmat.Schema.table("widgets")
    let sprocket = Harmat.Odbc.inserting(table, [("name", Harmat.Schema.Text("sprocket"))])
    let cog = Harmat.Odbc.inserting(table, [("name", Harmat.Schema.Text("cog"))])
    Assert.equal(Harmat.Odbc.execute(connection, sprocket), Ok(1))
    Assert.equal(Harmat.Odbc.execute(connection, cog), Ok(1))
    let listed = Harmat.Odbc.selecting(table, ["id", "name"], [], [])
    Assert.equal(Harmat.Odbc.query(connection, listed), Ok([["1", "sprocket"], ["2", "cog"]]))
    Assert.equal(Harmat.Migration.rollback(connection, [widgets]), Ok(["create_widgets"]))
    FS.File.delete(file)
  end
end
